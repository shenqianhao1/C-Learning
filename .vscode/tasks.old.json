{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Build active file (MSVC)",
            "type": "shell",
            "command": "call \"D:\\visual studio\\Community\\Common7\\Tools\\VsDevCmd.bat\" -no_logo -arch=x64 >nul && cl.exe /nologo /TC /std:c17 /W4 /Zi /Od /source-charset:utf-8 /execution-charset:.936 /D_CRT_SECURE_NO_WARNINGS \"${file}\" /Fe:\"${fileDirname}\\${fileBasenameNoExtension}.exe\" /Fo:\"${fileDirname}\\${fileBasenameNoExtension}.obj\" /Fd:\"${fileDirname}\\${fileBasenameNoExtension}.pdb\"",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "C: Run active file",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "C: Build active file (MSVC)",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc 生成活动文件",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}